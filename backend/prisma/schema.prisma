// Prisma schema - Sistema de Jueceo y Control de Accesos
// Fase actual: formulario de registro + pago (Stripe)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Categoria {
  KIDS_AMATEUR
  KIDS_BOYS
  KIDS_GIRL
  JUVENIL_BOYS
  JUVENIL_GIRL
  BGIRLS
  BBOYS
  PUBLICO_GENERAL
  OPEN_STYLE_1V1
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum TipoBoleto {
  GENERAL
  COMPETIDOR
  STAFF
  VIP
  INVITADO
}

enum EstatusPago {
  PENDIENTE
  PAGADO
  FALLIDO
  REEMBOLSADO
}

// Paquete base elegido por el registrante; los workshops (add-on) se
// guardan aparte en workshopsSeleccionados. Ver backend/src/config/catalog.ts
// para la tabla de precios y la función que calcula el total.
// NOTA: PRO_PACKAGE se fusionó con BOSS_VIP (mismo contenido, ver Mejoras_v3).
enum PaqueteBase {
  COMPETIDOR
  PUBLICO_GENERAL
  VIP_EXPERIENCE
  BOSS_EXPERIENCE
  BOSS_VIP
  SOLO_WORKSHOPS
  // DEPRECATED: ya no es seleccionable (quitado de PAQUETES_COMPETIDOR/PAQUETES_PUBLICO
  // en backend/frontend catalog.ts). Se conserva en el enum porque hay registros de
  // prueba existentes con este valor; no quitar sin antes migrar/borrar esas filas.
  PRUEBA_PAGO
}

enum RolAdmin {
  SUPER_ADMIN
  STAFF_ACCESO
  STAFF_JUECEO
  JUEZ
}

model AdminUser {
  id           String   @id @default(uuid())
  nombre       String
  correo       String   @unique
  passwordHash String
  rol          RolAdmin
  activo       Boolean  @default(true)

  // Solo tiene sentido para rol JUEZ: a qué escenario físico pertenece
  // durante la fase de Preselección (ver Escenario). Se ignora para los
  // demás roles. Nullable porque un JUEZ recién creado no tiene escenario
  // hasta que el admin se lo asigna — se bloquea con error claro al intentar
  // iniciar Preselección si hay jueces activos sin escenario asignado (ver
  // POST /categorias/:categoria/preseleccion/iniciar en competencia.ts).
  escenarioId String?
  escenario   Escenario? @relation(fields: [escenarioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calificacionesEmitidas          CalificacionJuez[]
  puntuacionesPreseleccionEmitidas PuntuacionPreseleccion[]
  eventosAcceso                   AccesoEvento[]

  @@map("admin_users")
}

// Escenario físico (tarima) donde se corre la fase de Preselección en
// paralelo con otros escenarios. Catálogo simple, sin FK a un "evento" (el
// sistema opera sobre un único evento activo a la vez, igual que
// ConfiguracionEvento). Los jueces (AdminUser.escenarioId) se reparten entre
// escenarios; los competidores de cada categoría se dividen proporcionalmente
// por orden de registro entre los escenarios que tengan al menos un juez
// activo asignado al momento de iniciar la Preselección de esa categoría —
// ver POST /categorias/:categoria/preseleccion/iniciar.
model Escenario {
  id     String  @id @default(uuid())
  nombre String  @unique
  // Desempata el reparto de "sobrantes" al dividir competidores en lotes
  // proporcionales, y define el orden de despliegue en el panel de admin.
  orden  Int     @default(0)
  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jueces       AdminUser[]
  turnos       TurnoPreseleccionEscenario[]
  competidores Registration[]

  @@map("escenarios")
}

// Estado actual del QR de acceso de un registro. Uno solo por QR:
// NO_USADO -> nunca se ha escaneado.
// DENTRO -> escaneado por primera vez, está dentro del evento.
// FUERA_TEMPORAL -> salió (ej. a comer), puede volver a entrar.
// REINGRESO -> volvió a entrar después de una salida temporal.
// BLOQUEADO -> el staff de acceso lo bloqueó a mano (fraude, mal comportamiento, etc).
enum EstadoAcceso {
  NO_USADO
  DENTRO
  FUERA_TEMPORAL
  REINGRESO
  BLOQUEADO
}

// Qué representó cada fila del log de AccesoEvento.
enum TipoEventoAcceso {
  ENTRADA
  SALIDA_TEMPORAL
  REINGRESO
  INTENTO_BLOQUEADO
  BLOQUEO
  DESBLOQUEO
}

// Log de auditoría de TODO evento de acceso (uno por escaneo o acción de
// bloqueo/desbloqueo), independiente del estado actual en Registration.estadoAcceso.
// Sirve para reconstruir el historial completo de entradas/salidas/reingresos
// de una persona y para investigar intentos de duplicidad (ver posibleDuplicado).
model AccesoEvento {
  id String @id @default(uuid())

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])

  tipo           TipoEventoAcceso
  estadoAnterior EstadoAcceso
  estadoNuevo    EstadoAcceso

  // true si este evento ocurrió muy poco después del evento anterior del mismo
  // QR (ver VENTANA_DUPLICADO_SEGUNDOS en backend/src/routes/access.ts):
  // posible señal de un QR clonado/compartido usado en dos accesos a la vez.
  posibleDuplicado          Boolean @default(false)
  segundosDesdeUltimoEvento Int?

  staffId String?
  staff   AdminUser? @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now())

  @@index([registrationId, createdAt])
  @@map("accesos_eventos")
}

enum EstatusCompetencia {
  NO_INICIADA
  // Fase de "Filtro"/Cypher estilo Red Bull BC One: los jueces puntúan a cada
  // inscrito individualmente (PuntuacionPreseleccion) antes de armar
  // cualquier enfrentamiento. Opcional por categoría — las chicas pueden
  // saltar directo a EN_CURSO y usar el sorteo aleatorio de siempre.
  PRESELECCION
  // Empate exacto detectado en la frontera del corte del Top N (ver
  // POST .../generar-top-bracket): los competidores involucrados vuelven a
  // presentarse, uno a uno, en su mismo escenario de origen, y los
  // recalifican los jueces de ese escenario — se repite hasta que
  // desempaten, mismo patrón que numeroDesempate en Enfrentamiento. Al
  // resolverse, el sistema arma el Top Bracket automáticamente y pasa a
  // EN_CURSO sin intervención del admin.
  REPECHAJE_DESEMPATE
  EN_CURSO
  FINALIZADA
}

// Estado en vivo de la competencia por categoría, controlado desde el panel
// de administración (Sección 2 "Admin Total"). Una fila por valor de Categoria.
model EstadoCategoria {
  categoria   Categoria           @id
  estatus     EstatusCompetencia  @default(NO_INICIADA)
  // Total de rondas del bracket generado (ceil(log2(N)) al momento de crearlo),
  // para poder nombrar bien las rondas siguientes al avanzar automáticamente.
  totalRondas Int?
  updatedAt   DateTime            @updatedAt

  @@map("estado_categorias")
}

// Turno actual de la fase de Preselección, uno por cada combinación de
// categoría+escenario activo en ella (reemplaza el turno único que existía
// antes de la Preselección Paralela Multiescenario): qué participante está
// en tarima ahora mismo EN ESE ESCENARIO, compartido entre /pantalla?escenario=
// (overlay con cronómetro, ver frontend/src/app/pantalla/SecuenciaPreseleccion.tsx)
// y admin/jueceo (a quién debe calificar un juez de ese escenario). Se crea
// al iniciar la Preselección de la categoría (ver
// POST /categorias/:categoria/preseleccion/iniciar) y se resetea (turnoActualId
// a null) para los competidores empatados al entrar a REPECHAJE_DESEMPATE.
model TurnoPreseleccionEscenario {
  id          String    @id @default(uuid())
  categoria   Categoria
  escenarioId String
  escenario   Escenario @relation(fields: [escenarioId], references: [id])

  turnoActualId   String?
  turnoActual     Registration? @relation(fields: [turnoActualId], references: [id])
  turnoIniciadoEn DateTime?
  // Momento en que el turno actual quedó completo (todos los jueces activos
  // de ESTE escenario ya calificaron), para poder avanzar solo al siguiente
  // sin depender de un setTimeout en memoria del proceso — si el servidor se
  // reinicia justo en esa ventana de espera (ej. hot-reload en dev), el
  // avance normal se pierde; con esto, cualquier siguiente consulta de
  // turno-actual detecta que ya se cumplió el tiempo y avanza sola (ver
  // turnoActualDeCategoria en backend/src/routes/competencia.ts).
  turnoCompletadoEn DateTime?
  updatedAt         DateTime  @updatedAt

  @@unique([categoria, escenarioId])
  @@map("turnos_preseleccion_escenario")
}

enum EstatusEnfrentamiento {
  PENDIENTE
  EN_CURSO
  FINALIZADO
}

// Modelo genérico mínimo de enfrentamientos/brackets, capturado a mano por el
// staff de jueceo desde el panel de admin. Se amplía cuando se defina el
// reglamento real de jueceo (armado de brackets, criterios de calificación).
model Enfrentamiento {
  id     String @id @default(uuid())
  categoria Categoria
  ronda  String // libre, ej. "Octavos", "Cuartos", "Semifinal", "Final"
  // Secuencia determinística de la ronda (1, 2, 3...) para el avance
  // automático del bracket; `ronda` sigue siendo el nombre legible.
  rondaNumero Int @default(1)
  orden  Int    @default(0)

  competidorAId String?
  competidorA   Registration? @relation("EnfrentamientoCompetidorA", fields: [competidorAId], references: [id])
  competidorBId String?
  competidorB   Registration? @relation("EnfrentamientoCompetidorB", fields: [competidorBId], references: [id])
  ganadorId     String?
  ganador       Registration? @relation("EnfrentamientoGanador", fields: [ganadorId], references: [id])

  estatus EstatusEnfrentamiento @default(PENDIENTE)

  // Si el admin corta el turno de un competidor antes de que se agote el
  // tiempo (ej. terminó su presentación a los 45s de un turno de 60s), se
  // guarda aquí el momento exacto del corte. La secuencia en /pantalla y en
  // el panel de control de pantallas (SUPER_ADMIN, ver
  // frontend/src/app/pantalla/SecuenciaBatalla.tsx) usa este timestamp en vez
  // de la duración fija para pasar al siguiente competidor sin esperar el
  // resto del tiempo.
  turnoACortadoEn DateTime?
  turnoBCortadoEn DateTime?

  // Cuántas veces se ha repetido esta MISMA pelea por empate (0 = todavía no
  // hubo empate). Estilo Red Bull BC One "sudden death": en vez de un
  // segundo criterio de desempate o resolución manual, se lanza una ronda
  // extra para los mismos dos competidores y los jueces vuelven a calificar
  // — se repite hasta que haya un ganador claro. Ver
  // intentarResolverEnfrentamiento en backend/src/routes/competencia.ts.
  numeroDesempate Int @default(0)

  // Cuántas veces presenta cada competidor antes de que los jueces
  // califiquen (1 = lo de siempre, A baila una vez y B baila una vez). Las
  // Finales se crean con 2 (ver filasParaRonda en
  // backend/src/routes/competencia.ts): A1, B1, A2, B2 y hasta ahí entran
  // los jueces — sigue siendo UNA sola calificación por juez al final,
  // sobre el total de ambas vueltas, no una calificación por vuelta.
  rondasBaile Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calificaciones CalificacionJuez[]

  @@index([categoria])
  @@map("enfrentamientos")
}

// Calificación de un juez para un enfrentamiento: puntúa a ambos competidores
// (A y B) en los 5 criterios del reglamento (Artículo 35), escala 1-5 cada
// uno. Un juez califica cada intento de una pelea una sola vez (@@unique
// incluye numeroDesempate, así que SÍ puede volver a calificar la misma
// pelea si llega a haber una ronda de desempate). El ganador se calcula
// sumando estos puntajes entre todos los jueces activos (ver
// intentarResolverEnfrentamiento en backend/src/routes/competencia.ts).
model CalificacionJuez {
  id String @id @default(uuid())

  enfrentamientoId String
  enfrentamiento   Enfrentamiento @relation(fields: [enfrentamientoId], references: [id])
  juezId           String
  juez             AdminUser      @relation(fields: [juezId], references: [id])

  // A qué ronda de desempate corresponde esta calificación puntual (0 =
  // calificación original). Evita mezclar puntajes de distintos intentos al
  // sumar — ver conPuntajes en backend/src/routes/competencia.ts.
  numeroDesempate Int @default(0)

  tecnicaA      Int
  ejecucionA    Int
  vocabularioA  Int
  musicalidadA  Int
  originalidadA Int

  tecnicaB      Int
  ejecucionB    Int
  vocabularioB  Int
  musicalidadB  Int
  originalidadB Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enfrentamientoId, numeroDesempate, juezId])
  @@map("calificaciones_juez")
}

// Puntuación individual de un juez a UN participante durante la fase de
// Preselección (Filtro/Cypher estilo Red Bull BC One), antes de que exista
// ningún Enfrentamiento: mismos 5 criterios del reglamento (Artículo 35),
// escala 1-5, pero sin comparar A vs B. Un juez puntúa a cada participante
// una sola vez (@@unique). El ranking para el corte del Top N se calcula
// sumando estos puntajes entre todos los jueces activos (ver
// generar-top-bracket en backend/src/routes/competencia.ts).
model PuntuacionPreseleccion {
  id String @id @default(uuid())

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])
  juezId         String
  juez           AdminUser    @relation(fields: [juezId], references: [id])

  // A qué ronda de desempate en la frontera de corte corresponde esta
  // calificación (0 = calificación original de Preselección). Evita mezclar
  // puntajes de distintos intentos al sumar — el puntaje vigente de un
  // competidor es siempre el de numeroDesempate = Registration.preseleccionNumeroDesempate.
  // Mismo patrón que numeroDesempate en CalificacionJuez, pero por
  // competidor (re-presentación individual) en vez de por pelea.
  numeroDesempate Int @default(0)

  tecnica      Int
  ejecucion    Int
  vocabulario  Int
  musicalidad  Int
  originalidad Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([registrationId, juezId, numeroDesempate])
  @@map("puntuaciones_preseleccion")
}

enum VistaPantalla {
  APAGADA
  BRACKETS
  RESULTADOS
  ENFRENTAMIENTOS
  GANADORES
  ACCESOS
}

// Fila única (id fijo = 1) con lo que se debe proyectar ahora mismo en las
// pantallas del evento. La pantalla pública hace poll de este endpoint.
model PantallaEstado {
  id                Int            @id @default(1)
  vista             VistaPantalla  @default(APAGADA)
  categoriaEnfocada Categoria?
  updatedAt         DateTime       @updatedAt

  @@map("pantalla_estado")
}

// Fila única (id fijo = 1): si el sistema completo (Preselección, Jueceo,
// Brackets, Pantalla, Tablero, Control de Accesos) debe operar sobre los
// registros del Evento de Prueba (Registration.esPrueba: true, capturados
// sin pago desde /evento-prueba) o sobre los reales pagados con Stripe. Se
// cambia desde un interruptor en el panel de SUPER_ADMIN — ver
// backend/src/lib/modoEvento.ts y PATCH /api/configuracion-evento.
model ConfiguracionEvento {
  id         Int      @id @default(1)
  modoPrueba Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("configuracion_evento")
}

model Registration {
  id                    String      @id @default(uuid())

  // Datos personales
  nombres               String
  apellidos             String
  nombreArtistico       String
  fechaNacimiento       DateTime
  categoria             Categoria
  sexo                  Sexo
  estado                String
  ciudad                String
  // Único junto con esPrueba (no solo) para que la misma persona pueda tener
  // un registro real Y uno de prueba con el mismo correo sin chocar — el
  // staff suele probar con sus propios correos reales durante un ensayo.
  correo                String
  telefono              String
  instagram             String?
  academiaCrew          String?
  contactoEmergencia    String?
  nacionalidad          String
  fotoUrl               String?

  // Consentimientos legales
  aceptaReglamento      Boolean     @default(false)
  aceptaAvisoPrivacidad Boolean     @default(false)
  aceptaUsoImagen       Boolean     @default(false)
  aceptaPoliticaCancelacion Boolean @default(false)

  // Boleto, paquete y pago
  tipoBoleto            TipoBoleto
  paqueteBase           PaqueteBase
  workshopsSeleccionados Int[]      @default([])
  workshopsOpenStyleSeleccionados Int[] @default([])
  agregarOpenStyle      Boolean     @default(false)
  precioMXNCentavos     Int
  estatusPago           EstatusPago @default(PENDIENTE)
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?

  // Acceso: el QR se genera al confirmarse el pago y es reutilizable durante
  // el evento (entradas/salidas temporales), ver backend/src/routes/access.ts.
  // qrEscaneadoEn guarda el momento de la PRIMERA entrada (no se sobrescribe
  // después); estadoAcceso es la fuente de verdad del estado actual, y
  // AccesoEvento lleva el historial completo de cada entrada/salida/reingreso.
  qrToken               String?      @unique
  qrEscaneadoEn         DateTime?
  estadoAcceso          EstadoAcceso @default(NO_USADO)

  // ID fijo de competidor (ej. "BB-023"), asignado al confirmarse el pago.
  // Se reutiliza entre años para el mismo correo, ver backend/src/routes/stripeWebhook.ts
  competidorId          String?     @unique

  // true si este registro vino de /evento-prueba (sin pago real, ver
  // backend/src/routes/registrationsPrueba.ts), no del formulario real con
  // Stripe. Todo lo que arma el roster de competidores (brackets,
  // preselección, control de accesos, vista de registros) filtra por este
  // campo según el modo activo — ver backend/src/lib/modoEvento.ts — para
  // que un ensayo nunca se mezcle con inscripciones reales, ni al revés.
  esPrueba              Boolean     @default(false)

  // Escenario asignado durante el reparto proporcional al iniciar la
  // Preselección de su categoría (snapshot, fijado una sola vez — ver
  // POST /categorias/:categoria/preseleccion/iniciar). Null antes de que
  // arranque la Preselección o para categorías que no la usan.
  preseleccionEscenarioId String?
  preseleccionEscenario   Escenario? @relation(fields: [preseleccionEscenarioId], references: [id])
  // Ronda vigente de desempate en la frontera de corte (0 = calificación
  // original). Solo sube para quienes quedan empatados en el límite del
  // Top N — ver REPECHAJE_DESEMPATE y PuntuacionPreseleccion.numeroDesempate.
  preseleccionNumeroDesempate Int @default(0)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  enfrentamientosComoA       Enfrentamiento[] @relation("EnfrentamientoCompetidorA")
  enfrentamientosComoB       Enfrentamiento[] @relation("EnfrentamientoCompetidorB")
  enfrentamientosGanados     Enfrentamiento[] @relation("EnfrentamientoGanador")
  eventosAcceso              AccesoEvento[]
  puntuacionesPreseleccion   PuntuacionPreseleccion[]
  turnosPreseleccionComoActual TurnoPreseleccionEscenario[]

  @@unique([correo, esPrueba])
  @@index([estatusPago])
  @@index([categoria])
  @@map("registrations")
}